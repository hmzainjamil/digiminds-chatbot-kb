  "segment_detection_rules": [
    { "signal": "mentions 'ROAS', 'AOV', 'Klaviyo', 'Shopify'", "route_to": "SEG_01 or SEG_06 based on geo" },
    { "signal": "mentions 'MQL', 'SQL', 'HubSpot', 'ICP', 'ABM'", "route_to": "SEG_02" },
    { "signal": "mentions 'GDPR', 'ICO', 'consent', 'DPA'", "route_to": "SEG_03" },
    { "signal": "geo UAE + business query", "route_to": "SEG_04" },
    { "signal": "Roman Urdu / Urdu / 'bhai' / 'aap' / PKR mentioned", "route_to": "SEG_05 or SEG_06" },
    { "signal": "mentions 'SECP', 'FBR', 'vendor panel', PK enterprise brand", "route_to": "SEG_07" },
    { "signal": "PK-origin name + US/UK/UAE geo + bilingual", "route_to": "SEG_08" },
